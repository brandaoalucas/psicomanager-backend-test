# ===============================================
# TASK MANAGEMENT SYSTEM - ENVIRONMENT CONFIG
# ===============================================

# -----------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------
APP_NAME="Task Management System"
APP_ENV=local
APP_KEY=base64:h2W09a8oa/Z6BA7IWQAFUh9cEJpB9zlXO72k7AOLjBY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000

# -----------------------------------------------
# LOGGING
# -----------------------------------------------
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------
# MYSQL DATABASE
# -----------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=tasks_db
DB_USERNAME=root
DB_PASSWORD=secret

# MySQL Container Configuration
MYSQL_ROOT_PASSWORD=secret
MYSQL_DATABASE=tasks_db
MYSQL_USER=task_user
MYSQL_PASSWORD=task_password
MYSQL_PORT=3307

# -----------------------------------------------
# MONGODB DATABASE
# -----------------------------------------------
# Laravel Application MongoDB Config
MONGO_DB_CONNECTION=mongodb
MONGO_DB_HOST=mongo
MONGO_DB_PORT=27017
MONGO_DB_DATABASE=audit_logs_db
MONGO_DB_USERNAME=admin
MONGO_DB_PASSWORD=secret
MONGO_DB_AUTH_SOURCE=admin

# MongoDB Container Configuration
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=secret
MONGO_INITDB_DATABASE=audit_logs_db
MONGO_PORT=27017

# MongoDB Connection URI (for direct connections)
MONGODB_URI="mongodb://admin:secret@mongo:27017/audit_logs_db?authSource=admin"
MONGODB_DATABASE=audit_logs_db

# -----------------------------------------------
# MONGO EXPRESS (Admin Interface)
# -----------------------------------------------
MONGO_EXPRESS_BASIC_AUTH_USERNAME=admin
MONGO_EXPRESS_BASIC_AUTH_PASSWORD=admin
MONGO_EXPRESS_PORT=8081

# -----------------------------------------------
# CACHE & SESSION
# -----------------------------------------------
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# -----------------------------------------------
# MAIL CONFIGURATION
# -----------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------
# SANCTUM AUTHENTICATION
# -----------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,127.0.0.1:8000,::1
SANCTUM_MASTER_PASSWORD=123456

# -----------------------------------------------
# SWAGGER DOCUMENTATION
# -----------------------------------------------
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_CONST_HOST=http://localhost:8000
