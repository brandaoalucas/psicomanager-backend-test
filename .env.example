# ===============================================
# TASK MANAGEMENT SYSTEM - ENVIRONMENT CONFIG
# ===============================================

# -----------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------
APP_NAME="Task Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# -----------------------------------------------
# LOGGING
# -----------------------------------------------
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------
# MYSQL DATABASE
# -----------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=tasks_db
DB_USERNAME=root
DB_PASSWORD=secret

# MySQL Root and User Config
MYSQL_ROOT_PASSWORD=secret
MYSQL_DATABASE=tasks_db
MYSQL_USER=task_user
MYSQL_PASSWORD=task_password

# -----------------------------------------------
# MONGODB DATABASE (Jenssegers)
# -----------------------------------------------
MONGO_DB_CONNECTION=mongodb
MONGO_DB_HOST=mongo
MONGO_DB_PORT=27017
MONGO_DB_DATABASE=audit_logs_db
MONGO_DB_USERNAME=
MONGO_DB_PASSWORD=
MONGO_DB_AUTH_DATABASE=admin

# MongoDB Root Config
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=secret
MONGO_INITDB_DATABASE=audit_logs_db

# -----------------------------------------------
# MONGO EXPRESS (Admin Interface)
# -----------------------------------------------
MONGO_EXPRESS_ADMIN_USERNAME=admin
MONGO_EXPRESS_ADMIN_PASSWORD=admin
MONGO_EXPRESS_BASIC_AUTH_USERNAME=admin
MONGO_EXPRESS_BASIC_AUTH_PASSWORD=admin

# -----------------------------------------------
# CACHE & SESSION
# -----------------------------------------------
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# -----------------------------------------------
# MAIL CONFIGURATION
# -----------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------
# SANCTUM AUTHENTICATION
# -----------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,127.0.0.1:8000,::1

# -----------------------------------------------
# DOCKER PORTS (for reference)
# -----------------------------------------------
APP_PORT=8000
MYSQL_PORT=3307
MONGO_PORT=27019
MONGO_EXPRESS_PORT=8082
