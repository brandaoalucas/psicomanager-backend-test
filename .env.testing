# -----------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------
APP_NAME="Task Management System - TESTING"
APP_ENV=testing
APP_KEY=base64:h2W09a8oa/Z6BA7IWQAFUh9cEJpB9zlXO72k7AOLjBY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# -----------------------------------------------
# LOGGING (MÍNIMO PARA TESTES)
# -----------------------------------------------
LOG_CHANNEL=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# -----------------------------------------------
# DATABASE - SQLITE EM MEMÓRIA (100% SEGURO!)
# -----------------------------------------------
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=:memory:
DB_USERNAME=root
DB_PASSWORD=secret
DB_FOREIGN_KEYS=true

# -----------------------------------------------
# MONGODB - BANCO SEPARADO PARA TESTES
# -----------------------------------------------
MONGO_DB_HOST=mongo
MONGO_DB_PORT=27017
MONGO_DB_DATABASE=test_audit_logs
MONGO_DB_USERNAME=admin
MONGO_DB_PASSWORD=secret
MONGO_DB_AUTH_SOURCE=admin

MONGODB_URI="mongodb://admin:secret@mongo:27017/test_audit_logs?authSource=admin"
MONGODB_DATABASE="test_audit_logs"

# -----------------------------------------------
# CACHE & SESSION - TUDO EM MEMÓRIA
# -----------------------------------------------
CACHE_DRIVER=array
CACHE_STORE=array
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
SESSION_LIFETIME=120

# -----------------------------------------------
# MAIL - FAKE
# -----------------------------------------------
MAIL_MAILER=array
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="test@example.com"
MAIL_FROM_NAME="Testing"

# -----------------------------------------------
# SANCTUM
# -----------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,127.0.0.1:8000,::1
SANCTUM_MASTER_PASSWORD=123

# -----------------------------------------------
# PERFORMANCE - DESABILITAR TUDO DESNECESSÁRIO
# -----------------------------------------------
TELESCOPE_ENABLED=false
DEBUGBAR_ENABLED=false
PULSE_ENABLED=false

# -----------------------------------------------
# BCRYPT ROUNDS (MENOS PARA PERFORMANCE EM TESTES)
# -----------------------------------------------
BCRYPT_ROUNDS=4
